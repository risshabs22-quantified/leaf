// Leaf on Cloudflare Containers: `make deploy-cloudflare` (see scripts/deploy_cloudflare.sh).
// Cost: Workers Paid ($5/month) covers 25 GiB-hours of memory a month; a `basic` instance
// (1/4 vCPU, 1 GiB) awake all month would add about $7. It sleeps after 30 idle minutes.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "leaf",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  // leafathon.site is the public address; leaf.risshabs-22.workers.dev keeps working too.
  "routes": [
    { "pattern": "leafathon.site", "custom_domain": true },
    { "pattern": "www.leafathon.site", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "LeafContainer",
      "image": "../Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "LEAF", "class_name": "LeafContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LeafContainer"] }],
  // Platform data (docs/LEAF_PLATFORM.md). The container reaches these through the bridge in
  // src/index.ts (outbound interception), never directly. Migrations are the same SQL files
  // the Python side applies locally; the deploy script applies them before every deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leaf-platform",
      "database_id": "af08d677-6725-43a5-bf50-8dc65c6b6936",
      "migrations_dir": "../backend/data/migrations"
    }
  ],
  // Shared caches only (one write per second per key, eventually consistent).
  "kv_namespaces": [{ "binding": "KV", "id": "ecbfc2b43c264b8a9a7e96bdb9f0e1bf" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "leaf-jobs" }],
    "consumers": [
      {
        "queue": "leaf-jobs",
        // One container instance: a few at a time, one batch at a time. 3 jobs x 240 s stays
        // inside the consumer's 15-minute limit.
        "max_batch_size": 3,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "max_retries": 5,
        "dead_letter_queue": "leaf-jobs-dlq"
      }
    ]
  },
  // UTC. Each run wakes the container only when there is work (docs/LEAF_PLATFORM.md, "Jobs").
  "triggers": { "crons": ["17 7 * * *", "5 * * * *", "35 */3 * * *", "0 6 * * MON-FRI"] },
  // Not secret. API keys are Worker secrets, set by the deploy script from .env.
  "vars": {
    "LEAF_DAILY_CAP": "60",
    "LEAF_TRUSTED_PROXY_HOPS": "1",
    "LEAF_JOURNAL_BUCKET": "leaf-journal",
    "LEAF_PUBLIC_URL": "https://leafathon.site",
    "LEAF_PLATFORM_URL": "http://leaf-platform.internal",
    "LEAF_SPEND_CAP_USD": "3",
    // Web Push public key (not secret; the private key is a Worker secret).
    "VAPID_PUBLIC_KEY": "BFQi-bEmXlUw--QfSymJraCa1UKb0JAP2iMEiV8B2pW-otSqSuYB1XpbDc4OHEZ5r0VblK5IuMviSaTpDmn-cC8",
    "AWS_ENDPOINT_URL": "https://a5df400bbbb2f6a57594bc84d3d11c56.r2.cloudflarestorage.com",
    "AWS_REGION": "auto"
  }
}
