# Copy to .env (make setup does this). Never commit .env.

# Required: Nebius Token Factory key (tokenfactory.nebius.com -> API keys)
NEBIUS_API_KEY=
# Required for the Tavily prize and cited plans (Builder Program gives $25 credit)
TAVILY_API_KEY=

# Optional overrides. Defaults live in backend/config.py.
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# LEAF_REASON_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# LEAF_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b
# LEAF_FAST_MODEL=nvidia/Nemotron-3_5-Lightning
# LEAF_VISION_MODEL=            # empty = auto-detect an image-capable model
# If `make smoke` says a model lives in another region, paste its line here, e.g.:
# LEAF_MODEL_BASE_URLS=nvidia/Nemotron-3-Ultra-550b-a55b=https://api.tokenfactory.us-central1.nebius.com/v1/

# Demo credit protection
# LEAF_PER_IP_PER_HOUR=20
# LEAF_DAILY_CAP=60           # all /api requests per day (diagnose + chat)
# LEAF_TAVILY_DAILY_CAP=0     # optional ceiling; by default the daily Tavily credit cap is
#                             # (plan limit - used - 100) / days left in the month, read daily
# LEAF_TIMEOUT_S=120          # per model attempt; the SDK retries twice
# LEAF_DEADLINE_S=100         # whole request, across all fallbacks (then HTTP 504)
# LEAF_MAX_CONCURRENT=8       # simultaneous diagnoses/chats; extra requests get HTTP 503
# LEAF_TRUSTED_PROXY_HOPS=1   # proxies that append to X-Forwarded-For (0 when run directly)

# Deep mode (the investigator agent)
# LEAF_DEEP_DAILY_CAP=20      # Deep cases per day; past it Leaf runs Quick and says so
# LEAF_DEEP_MAX_CALLS=8       # counted tool calls per case
# LEAF_DEEP_WALL_S=90         # hard time limit for the investigation
# LEAF_DEEP_BUDGET_USD=0.10   # model spend per case
# LEAF_DEEP_SEED=1            # start from the first differential (0 = from nothing)
# LEAF_DEEP_BLEND=0.7         # weight of the first differential in the final ranking

# Vision
# LEAF_CHECKLIST=0            # 1 adds a structured symptom checklist to the vision step (did not help on the tune split)

# Plant journal
# LEAF_JOURNAL_PATH=data/leaf.db   # "memory" keeps reports in this process only
# LEAF_JOURNAL_DAYS=30
# In production, keep reports in an Object Storage bucket instead (S3-compatible). boto3 reads
# the AWS_* variables; on Nebius set them as endpoint secrets, never in the image.
# LEAF_JOURNAL_BUCKET=leaf-journal
# AWS_ENDPOINT_URL=https://storage.eu-north1.nebius.cloud
# AWS_REGION=eu-north1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
